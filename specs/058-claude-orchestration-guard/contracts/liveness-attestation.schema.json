{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-braid.dev/specs/058-claude-orchestration-guard/contracts/liveness-attestation.schema.json",
  "title": "Agent Braid guard liveness attestation (draft, not adopted)",
  "description": "Whether the guard was actually consulted on a surface at a host version. The state defaults to advisory. observed requires a canary seen inside the validity window and a receipt. Counts only. Timestamps are patterns, not a format, so validation does not depend on a format checker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionAuthorization",
    "state",
    "hostVersion",
    "surface",
    "output",
    "counters"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-braid-guard-liveness/v0.1"
    },
    "executionAuthorization": {
      "const": false
    },
    "state": {
      "enum": [
        "advisory",
        "observed",
        "degraded"
      ],
      "default": "advisory"
    },
    "hostVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,31}(?!\\n)$"
    },
    "surface": {
      "enum": [
        "workflow-tracks",
        "linked-sessions",
        "agent-teams",
        "batch"
      ]
    },
    "output": {
      "enum": [
        "native-host-settings",
        "companion-plugin-hooks",
        "settings-snippet"
      ]
    },
    "canaryObservedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z(?!\\n)$",
      "description": "UTC date-time, for example 2026-10-24T12:00:00Z."
    },
    "validUntil": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z(?!\\n)$",
      "description": "UTC date-time, for example 2026-10-24T12:00:00Z."
    },
    "receipt": {
      "$ref": "#/$defs/repositoryText",
      "minLength": 1
    },
    "degradedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "tamper-suspected",
          "guard-error",
          "timeout",
          "canary-missing",
          "expired"
        ]
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventsExpected",
        "eventsObserved",
        "errors",
        "timeouts"
      ],
      "properties": {
        "eventsExpected": {
          "type": "integer",
          "minimum": 0
        },
        "eventsObserved": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "timeouts": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "observed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "canaryObservedAt",
          "validUntil",
          "receipt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "degraded"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "degradedBy"
        ]
      }
    }
  ],
  "$defs": {
    "repositoryText": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u115f-\\u1160\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\u3164\\ufeff\\uffa0\\ufff9-\\ufffb\\U000e0000-\\U000e007f]*(?!\\n)$",
      "description": "Reused byte for byte from SPEC-057 contracts/hazard-notice.schema.json $defs/repositoryText (REQ-008 of SPEC-057): the single definition of the escaping and bounding rule. A conformance test compares this definition with SPEC-057's."
    }
  }
}
