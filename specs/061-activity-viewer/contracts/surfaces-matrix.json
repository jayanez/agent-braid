              "PostToolUse",
              "duration_ms"
            ]
          },
          "waiting": {
            "status": "absent",
            "basis": "policy",
            "evidence": null,
            "note": "None of the five admitted observational events carries a waiting signal; any other hook event is refused. Notification-style events are not probed or admitted.",
            "receiptNames": []
          },
          "turn.idle": {
            "status": "absent",
            "basis": "policy",
            "evidence": null,
            "note": "The Stop event is a decision event and is refused (REQ-005), so no idle state is derived.",
            "receiptNames": []
          },
          "outcome": {
            "status": "absent",
            "basis": "receipt",
            "evidence": "hv-t030-20261101.json",
            "note": "Hook payloads state no outcome (SessionEnd has a reason that is not read); lanes close as unknown.",
            "receiptNames": [
              "SessionEnd"
            ]
          }
        }
      },
