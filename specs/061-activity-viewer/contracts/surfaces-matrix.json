  "hostParity": {
    "schemaVersion": "agent-braid-view-host-parity/v0.1",
    "contract": "host-parity.md",
    "capabilityValues": [
      "provided",
      "absent",
      "unknown"
    ],
    "basisValues": [
      "receipt",
      "policy",
      "derived",
      "none"
    ],
    "rule": "A cell changes from unknown only from a host-verification receipt in specs/061-activity-viewer/evidence/ (or a policy of the contract); absent and unknown are shown as not provided by this host, never as zero.",
    "capabilities": [
      {
        "id": "session.open",
        "loomKind": "strand.open",
        "since": "v0.1",
        "member": null,
        "values": [
          "agent"
        ],
        "meaning": "A session lane opens (role agent, no parent).",
        "valueProperty": "role"
      },
      {
        "id": "session.close",
        "loomKind": "strand.close",
        "since": "v0.1",
        "member": null,
        "values": [],
        "meaning": "The session lane closes; the viewer closes its open subagent lanes with it."
      },
      {
        "id": "subagent.open",
        "loomKind": "strand.open",
        "since": "v0.1",
        "member": null,
        "values": [
          "subagent"
        ],
        "meaning": "A subagent branch opens under the session lane.",
        "valueProperty": "role"
      },
      {
        "id": "subagent.close",
        "loomKind": "strand.close",
        "since": "v0.1",
        "member": null,
        "values": [],
        "meaning": "The subagent branch closes."
      },
      {
        "id": "tool.call",
        "loomKind": "strand.update",
        "since": "v0.1",
        "member": null,
        "values": [
          "running"
        ],
        "meaning": "A tool call becomes a bead on the lane that ran it, labelled by tool name only.",
        "valueProperty": "state"
      },
      {
        "id": "tool.duration",
        "loomKind": "strand.update",
        "since": "v0.2",
        "member": "toolDurationMs",
        "values": [],
        "meaning": "The host-stated duration of that tool call, integer milliseconds, held in memory only."
      },
      {
        "id": "waiting",
        "loomKind": "strand.update",
        "since": "v0.2",
        "member": "waitingOn",
        "values": [
          "waiting"
        ],
        "meaning": "The host says the lane is blocked; waitingBasis comes with it.",
        "valueProperty": "state"
      },
      {
        "id": "turn.idle",
        "loomKind": "strand.update",
        "since": "v0.1",
        "member": null,
        "values": [
          "idle"
        ],
        "meaning": "The host says a turn ended and the lane is idle (not closed).",
        "valueProperty": "state"
      },
      {
        "id": "outcome",
        "loomKind": "strand.close",
        "since": "v0.1",
        "member": null,
        "values": [
          "ok",
          "failed",
          "cancelled"
        ],
        "meaning": "The host states how a lane ended; otherwise the outcome is unknown.",
        "valueProperty": "outcome"
      }
    ],
