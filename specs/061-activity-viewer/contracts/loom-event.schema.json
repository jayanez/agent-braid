                  "hazards-found",
                  "ok-analyzed",
                  "ok-certified"
                ]
              },
              "operationCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "runtime.phase"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifestDigest",
              "phase"
            ],
            "properties": {
              "manifestDigest": {
                "type": "string",
                "pattern": "^(?:sha256:[0-9a-f]{64}|[A-Za-z0-9][A-Za-z0-9_.:-]{0,63})$"
              },
              "phase": {
                "enum": [
                  "initializing",
                  "ready",
                  "applying",
                  "completed",
                  "aborting",
                  "aborted"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "effort.sample"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strandId",
              "basis",
              "model",
              "inputTokens",
              "outputTokens",
              "cacheReadTokens",
              "cacheCreationTokens",
              "cachedInputTokens",
              "reasoningTokens",
              "costUsd",
              "durationMs"
            ],
            "properties": {
              "strandId": {
                "type": "string",
                "pattern": "^(?:sha256:[0-9a-f]{64}|[A-Za-z0-9][A-Za-z0-9_.:-]{0,63})$"
              },
              "basis": {
                "const": "host-estimate"
              },
              "model": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "inputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cacheReadTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cacheCreationTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cachedInputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reasoningTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "costUsd": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000.0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "durationMs": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "observation.gap"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "strandId",
              "fromSeq",
              "toSeq"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "subagent-usage-unattributed",
                  "stream-truncated",
                  "shape-unpinned",
                  "source-unsupported",
                  "ring-evicted",
                  "host-unverified",
                  "not-observed"
                ]
              },
              "strandId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:sha256:[0-9a-f]{64}|[A-Za-z0-9][A-Za-z0-9_.:-]{0,63})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fromSeq": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "toSeq": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "crossing.classified"
          }
        }
      },
      "then": {
        "properties": {
          "assurance": {
            "properties": {
              "compatibilityClass": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "gate.result"
          }
        }
      },
      "then": {
        "properties": {
          "assurance": {
            "properties": {
              "compatibilityClass": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "session.origin",
              "analysis.report",
              "strand.open",
              "strand.update",
              "strand.close",
              "wave.planned",
              "wave.started",
              "wave.finished",
              "grant.issued",
              "grant.consumed",
              "grant.expired",
              "grant.refused",
              "hazard.noticed",
              "gate.phase",
              "runtime.phase",
              "effort.sample",
              "observation.gap"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "assurance": {
            "properties": {
              "compatibilityClass": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
