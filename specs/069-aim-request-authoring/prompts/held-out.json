{
  "setId": "spec069-held-out-v1",
  "cases": [
    {
      "id": "HELD-01",
      "prompt": "Use Agent Braid to check whether two documentation tasks can safely run at once. One person will add a section for a new endpoint to docs/api.md. Another will fix the code examples in docs/api.md.",
      "expect": {
        "kind": "aim",
        "units": [
          {
            "key": "a",
            "effects": [
              {
                "kind": "write",
                "resource": "docs/api.md"
              }
            ],
            "dependsOn": []
          },
          {
            "key": "b",
            "effects": [
              {
                "kind": "write",
                "resource": "docs/api.md"
              }
            ],
            "dependsOn": []
          }
        ],
        "pairs": [
          {
            "left": "a",
            "right": "b",
            "classification": "conflicting",
            "constraints": [
              "serialize-or-isolate"
            ]
          }
        ]
      }
    },
    {
      "id": "HELD-02",
      "prompt": "Use Agent Braid to check whether these two changes can go ahead in parallel: one adds a new test to tests/test_api.py, the other speeds up the connection code in src/db.py.",
      "expect": {
        "kind": "aim",
        "units": [
          {
            "key": "a",
            "effects": [
              {
                "kind": "write",
                "resource": "tests/test_api.py"
              }
            ],
            "dependsOn": []
          },
          {
            "key": "b",
            "effects": [
              {
                "kind": "write",
                "resource": "src/db.py"
              }
            ],
            "dependsOn": []
          }
        ],
        "pairs": [
          {
            "left": "a",
            "right": "b",
            "classification": "independent-candidate",
            "constraints": [
              "requires-execution-contract-before-parallelism"
            ]
          }
        ]
      }
    },
    {
      "id": "HELD-03",
      "prompt": "Use Agent Braid to check which of these three pieces of planned work can run in parallel. Piece one renames a helper in src/utils.py and updates its use in src/db.py. Piece two adds docstrings to src/utils.py. Piece three adds an entry to CHANGELOG.md.",
      "expect": {
        "kind": "aim",
        "units": [
          {
            "key": "one",
            "effects": [
              {
                "kind": "write",
                "resource": "src/utils.py"
              },
              {
                "kind": "write",
                "resource": "src/db.py"
              }
            ],
            "dependsOn": []
          },
          {
            "key": "two",
            "effects": [
              {
                "kind": "write",
                "resource": "src/utils.py"
              }
            ],
            "dependsOn": []
          },
          {
            "key": "three",
            "effects": [
              {
                "kind": "write",
                "resource": "CHANGELOG.md"
              }
            ],
            "dependsOn": []
          }
        ],
        "pairs": [
          {
            "left": "one",
            "right": "three",
            "classification": "independent-candidate",
            "constraints": [
              "requires-execution-contract-before-parallelism"
            ]
          },
          {
            "left": "one",
            "right": "two",
            "classification": "conflicting",
            "constraints": [
              "serialize-or-isolate"
            ]
          },
          {
            "left": "three",
            "right": "two",
            "classification": "independent-candidate",
            "constraints": [
              "requires-execution-contract-before-parallelism"
            ]
          }
        ]
      }
    },
    {
      "id": "HELD-04",
      "prompt": "Use Agent Braid to check how these three tasks relate. Task one adds a new setting to config/production.yaml. Task two changes src/db.py to read that setting, so it can only start after task one is finished. Task three updates docs/api.md to describe the behaviour, and can only start after task two is finished.",
      "expect": {
        "kind": "aim",
        "units": [
          {
            "key": "one",
            "effects": [
              {
                "kind": "write",
                "resource": "config/production.yaml"
              }
            ],
            "dependsOn": []
          },
          {
            "key": "two",
            "effects": [
              {
                "kind": "write",
                "resource": "src/db.py"
              },
              {
                "kind": "read",
                "resource": "config/production.yaml",
                "optional": true
              }
            ],
            "dependsOn": [
              "one"
            ]
          },
          {
            "key": "three",
            "effects": [
              {
                "kind": "write",
                "resource": "docs/api.md"
              }
            ],
            "dependsOn": [
              "two"
            ]
          }
        ],
        "pairs": [
          {
            "left": "one",
            "right": "three",
            "classification": "ordered",
            "constraints": [
              "preserve-dependency-order"
            ]
          },
          {
            "left": "one",
            "right": "two",
            "classification": "ordered",
            "constraints": [
              "preserve-dependency-order"
            ]
          },
          {
            "left": "three",
            "right": "two",
            "classification": "ordered",
            "constraints": [
              "preserve-dependency-order"
            ]
          }
        ]
      }
    },
    {
