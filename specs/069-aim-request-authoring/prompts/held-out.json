            "dependsOn": []
          },
          {
            "key": "two",
            "effects": [
              {
                "kind": "read",
                "resource": "package.json"
              }
            ],
            "dependsOn": []
          },
          {
            "key": "three",
            "effects": [
              {
                "kind": "write",
                "resource": "package.json"
              }
            ],
            "dependsOn": []
          }
        ],
        "pairs": [
          {
            "left": "one",
            "right": "three",
            "classification": "conflicting",
            "constraints": [
              "serialize-or-isolate"
            ]
          },
          {
            "left": "one",
            "right": "two",
            "classification": "independent-candidate",
            "constraints": [
              "requires-execution-contract-before-parallelism"
