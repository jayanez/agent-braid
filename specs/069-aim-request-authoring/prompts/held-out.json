    {
      "id": "HELD-08",
      "prompt": "Use Agent Braid to check whether the work on the two branches tests-api and docs-faq of the project repository can proceed in parallel. Both branches were cut from main.",
      "expect": {
        "kind": "git",
        "units": [
          {
            "key": "a",
            "revision": "tests-api",
            "dependsOn": []
