    },
    {
      "id": "DEV-08",
      "prompt": "Use Agent Braid to check whether the work on the two branches docs-guide and src-api of the project repository can proceed in parallel. Both branches were cut from main.",
      "expect": {
        "kind": "git",
        "units": [
          {
            "key": "a",
            "revision": "docs-guide",
            "dependsOn": []
          },
          {
            "key": "b",
            "revision": "src-api",
            "dependsOn": []
          }
        ],
        "baseRevision": "main",
        "pairs": [
          {
            "left": "a",
            "right": "b",
            "classification": "independent-candidate",
            "constraints": [
              "requires-execution-contract-before-parallelism"
            ]
          }
        ]
      }
    },
    {
      "id": "DEV-09",
      "prompt": "Use Agent Braid to check whether the work on the two branches readme-badge and readme-intro of the project repository can proceed in parallel. Both branches were cut from main.",
      "expect": {
        "kind": "git",
        "units": [
          {
            "key": "a",
            "revision": "readme-badge",
            "dependsOn": []
