  "cards": [
    {
      "dot": "rose",
      "title": "No authority from the lab",
      "items": [
        "The harness CLI is offline and read-only except prepare, which writes one new private directory",
        "No verdict promotes or activates a profile; a human decision is required and not yet delivered"
      ]
    },
    {
      "dot": "cyan",
      "title": "Open work",
      "items": [
        "Native Claude containment (SPEC-065): built, not qualified or authorized",
