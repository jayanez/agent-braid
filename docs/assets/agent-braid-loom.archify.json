  "edges": [
    {
      "id": "convert",
      "from": "artifacts",
      "to": "adapters",
      "variant": "default"
    },
    {
      "id": "stream",
      "from": "hooks",
      "to": "adapters",
      "label": "planned",
      "variant": "dashed"
    },
    {
      "id": "check",
      "from": "adapters",
      "to": "validate",
      "variant": "default"
    },
    {
      "id": "keep",
      "from": "validate",
      "to": "store",
      "variant": "default"
    },
    {
      "id": "derive",
      "from": "store",
      "to": "model",
      "variant": "emphasis"
