    "legend": {
      "entries": {
        "external": {
          "label": "Activity source"
        },
        "backend": {
          "label": "Loom library (merged)"
        },
        "database": {
          "label": "In-memory store"
        },
        "messagebus": {
          "label": "Planned transport"
        },
        "frontend": {
          "label": "Planned viewer"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "sources",
      "label": "Activity sources"
    },
    {
      "id": "library",
      "label": "Loom library (merged in develop)"
