{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-braid.dev/schemas/agent-interaction-metadata.schema.json",
  "title": "Agent Interaction Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["aimVersion", "operation", "effects", "properties", "evidence"],
  "properties": {
    "aimVersion": {
      "const": "0.1.0-draft"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "properties": {
      "$ref": "#/$defs/algebraicProperties"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predicateReference"
      },
      "default": []
    },
    "postconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predicateReference"
      },
      "default": []
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resource"],
      "properties": {
        "kind": {
          "enum": ["read", "write", "call", "transform", "emit", "delete", "deploy", "unknown"]
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/predicateReference"
        }
      }
    },
    "algebraicProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["determinism", "idempotence", "reversibility"],
      "properties": {
        "determinism": {
          "$ref": "#/$defs/fourValue"
        },
        "idempotence": {
          "$ref": "#/$defs/fourValue"
        },
        "reversibility": {
          "enum": ["yes", "no", "conditional", "compensatable", "unknown"]
        }
      }
    },
    "fourValue": {
      "enum": ["yes", "no", "conditional", "unknown"]
    },
    "predicateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "assuranceLevel"],
      "properties": {
        "source": {
          "enum": ["declared", "inferred", "observed", "empirical", "proof-rule", "formal"]
        },
        "assuranceLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "artifact": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string"
        }
      }
    }
  }
}
