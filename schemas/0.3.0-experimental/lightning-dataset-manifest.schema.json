{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jayanez/agent-braid/schemas/0.3.0-experimental/lightning-dataset-manifest.schema.json",
  "title": "Braid Lightning dataset manifest",
  "description": "Experimental. Contract: specs/075-lightning-dataset-export/contracts/dataset-manifest.md. Builder: agent_braid/lightning_export.py (SPEC-075). The builder additionally checks that recordsSha256, each record sha256 and digest match the bytes they cover.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "kind",
    "level",
    "generatedAt",
    "seed",
    "balance",
    "orderingKey",
    "redactionVersion",
    "termsDecision",
    "canaryScan",
    "exclusions",
    "balanceReport",
    "retention",
    "records",
    "recordsSha256",
    "digest"
  ],
  "properties": {
    "manifestVersion": {
      "const": "braid-lightning-dataset-manifest/v0.1"
    },
    "kind": {
      "enum": [
        "supervised",
        "rollout"
      ]
    },
    "level": {
      "enum": [
        "transition",
        "trajectory"
      ]
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC; excluded from digest."
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "balance": {
      "enum": [
        "equal",
        "none"
      ]
    },
    "orderingKey": {
      "const": [
        "taskId",
        "groupId",
        "rolloutId",
        "attemptId",
        "turnIndex"
      ]
    },
    "redactionVersion": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./-]{0,127}$"
    },
    "termsDecision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "canaryScan": {
      "const": "clean"
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no-consent",
        "consent-none",
        "unredacted",
        "content-missing",
        "balance",
        "overlong",
        "retention-expired"
      ],
      "properties": {
        "no-consent": {
          "type": "integer",
          "minimum": 0
        },
        "consent-none": {
          "type": "integer",
          "minimum": 0
        },
        "unredacted": {
          "type": "integer",
          "minimum": 0
        },
        "content-missing": {
          "type": "integer",
          "minimum": 0
        },
        "balance": {
          "type": "integer",
          "minimum": 0
        },
        "overlong": {
          "type": "integer",
          "minimum": 0
        },
        "retention-expired": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "balanceReport": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "successes",
          "failures",
          "unknown",
          "keptPerOutcome",
          "dropped",
          "singleOutcome"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "successes": {
            "type": "integer",
            "minimum": 0
          },
          "failures": {
            "type": "integer",
            "minimum": 0
          },
          "unknown": {
            "type": "integer",
            "minimum": 0
          },
          "keptPerOutcome": {
            "type": "integer",
            "minimum": 0
          },
          "dropped": {
            "type": "integer",
            "minimum": 0
          },
          "singleOutcome": {
            "type": "boolean"
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "retentionDays",
          "expiresAt"
        ],
        "properties": {
          "retentionDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "expiresAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordId",
          "sha256",
          "runId",
          "taskId",
          "groupId",
          "rolloutId",
          "attemptId",
          "turnRange",
          "consentLevel",
          "source",
          "outcome",
          "limits"
        ],
        "properties": {
          "recordId": {
            "type": "string",
            "pattern": "^r-[0-9a-f]{16}$",
            "description": "r- plus the first 16 hex of the SHA-256 of the canonical record without recordId."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the record's JSONL line (canonical bytes plus newline)."
          },
          "runId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "taskId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "groupId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "rolloutId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "attemptId": {
            "type": "string",
            "pattern": "^attempt-[0-9a-f]{16}$",
            "description": "SPEC-074 salted attempt pseudonym; never the raw attempt id."
          },
          "turnRange": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "items": false
          },
          "consentLevel": {
            "const": "redacted"
          },
          "source": {
            "enum": [
              "host-model",
              "fixture",
              "local-model"
            ]
          },
          "outcome": {
            "enum": [
              "success",
              "failure",
              "unknown"
            ]
          },
          "limits": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "text-level-merge",
                "truncated"
              ]
            }
          }
        }
      }
    },
    "recordsSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical manifest without generatedAt and digest."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "supervised"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "balance": {
            "const": "none"
          },
          "balanceReport": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "records": {
            "contains": {
              "properties": {
                "source": {
                  "const": "host-model"
                }
              },
              "required": [
                "source"
              ]
            }
          }
        },
        "required": [
          "records"
        ]
      },
      "then": {
        "properties": {
          "termsDecision": {
            "type": "object"
          }
        }
      }
    }
  ]
}
