{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-braid.dev/schemas/0.1.0-alpha/git-integration-prototype-report.schema.json",
  "title": "Agent Braid bounded Git integration prototype report 0.1.0-alpha",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gitIntegrationPrototypeReportVersion", "status", "baseCommit", "targetRef", "targetCommit",
    "candidateWaves", "operationPreparations", "candidateIntegration", "serialReference",
    "comparison", "declaredTrackedTreeCheck", "unsafeAdmissionCount", "sourceTargetRefMatchesPinnedBaseAtFinalCheck", "executionAuthorization",
    "promotionPerformed", "reportDigest"
  ],
  "properties": {
    "gitIntegrationPrototypeReportVersion": {"const": "0.1.0-alpha"},
    "status": {"enum": ["completed", "inconclusive", "stale-base", "manual-review"]},
    "repositoryId": {"$ref": "#/$defs/digest"},
    "baseCommit": {"$ref": "#/$defs/oid"},
    "baseTree": {"$ref": "#/$defs/oid"},
    "targetRef": {"type": "string", "minLength": 1},
    "targetCommit": {"oneOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]},
    "targetCommitAtFinalCheck": {"oneOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]},
    "analysisDigest": {"$ref": "#/$defs/digest"},
    "provenanceDigest": {"$ref": "#/$defs/digest"},
    "observationContract": {"const": "private-tracked-tree-v1"},
    "footprintContract": {"const": "declared-static-read-write-and-shared-resource-v1"},
    "footprintsDynamicallyObserved": {"const": false},
    "operationOrder": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "operationDeclarations": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/declaration"}},
    "candidateWaves": {"type": "array", "maxItems": 4, "items": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}}},
    "operationPreparations": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/preparation"}},
    "serialPreparations": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/preparation"}},
    "candidateIntegration": {"$ref": "#/$defs/lane"},
    "serialReference": {"$ref": "#/$defs/lane"},
    "comparison": {
      "type": "object", "additionalProperties": false, "required": ["status", "treesEqual"],
      "properties": {
        "status": {"enum": ["match", "divergent", "inconclusive", "not-run"]},
        "treesEqual": {"type": ["boolean", "null"]}
      }
    },
    "declaredTrackedTreeCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "expectedTree"],
      "properties": {
        "status": {"enum": ["not-declared", "not-run", "passed", "failed"]},
        "expectedTree": {"oneOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]}
      }
    },
    "unsafeAdmissionCount": {"type": "integer", "minimum": 0},
    "metrics": {"type": "object", "additionalProperties": {"type": ["number", "string"]}},
    "resources": {"type": "object"},
    "resourceLimits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "sourceTargetRefMatchesPinnedBaseAtFinalCheck": {"type": "boolean"},
    "executionAuthorization": {"const": false},
    "promotionPerformed": {"const": false},
    "limits": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reason": {"type": "string", "minLength": 1},
    "reportDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "declaration": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "attemptId", "sourceCommit", "dependencies", "reads", "writes", "sharedResources", "footprintComplete", "patchDigest", "actualChangedPaths"],
      "properties": {
        "operationId": {"type": "string"}, "attemptId": {"type": "string"},
        "sourceCommit": {"$ref": "#/$defs/oid"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "reads": {"type": "array", "items": {"type": "string"}},
        "writes": {"type": "array", "items": {"type": "string"}},
        "sharedResources": {"type": "array", "items": {"type": "string"}},
        "footprintComplete": {"type": "boolean"}, "patchDigest": {"$ref": "#/$defs/digest"},
        "actualChangedPaths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "preparation": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "status", "preparedTree", "sourceTree", "matchesSourceTree", "elapsedNanoseconds"],
      "properties": {
        "operationId": {"type": "string"},
        "status": {"enum": ["complete", "tree-mismatch", "patch-rejected", "not-run"]},
        "preparedTree": {"oneOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]},
        "sourceTree": {"$ref": "#/$defs/oid"}, "matchesSourceTree": {"type": "boolean"},
        "elapsedNanoseconds": {"type": "integer", "minimum": 0}
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "finalTree", "steps", "failure"],
      "properties": {
        "status": {"enum": ["not-run", "complete", "conflict", "stale-base", "inconclusive"]},
        "finalTree": {"oneOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]},
        "steps": {"type": "array", "items": {"type": "object"}},
        "failure": {"oneOf": [{"type": "string"}, {"type": "null"}]}
      }
    }
  }
}
