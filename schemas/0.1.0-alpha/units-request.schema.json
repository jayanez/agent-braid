{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-braid.dev/schemas/0.1.0-alpha/units-request.schema.json",
  "$comment": "SPEC-069 REQ-006: analyze-work kind units, request version 0.1.0-alpha. Agent Braid builds one AIM 0.2.0-draft record per unit (agent_braid/units.py) with coverage forced to partial and declared, class-0 evidence; the construction table is in specs/069-aim-request-authoring/contracts/analyze-work-request.md. The resource pattern states the lexical refusals (scheme or drive letter, leading /, .. segment, backslash, control character, blank, no path). Runtime-only checks that JSON Schema cannot express: unique unit ids, known, non-self and acyclic dependencies, resources that differ only by letter case, and the 256-byte identifier bound (maxLength counts code points). coverage is accepted but never honoured.",
  "title": "Agent Braid units request 0.1.0-alpha",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "unitsRequestVersion": {
      "const": "0.1.0-alpha"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "read",
                    "write",
                    "call",
                    "transform",
                    "emit",
                    "delete",
                    "deploy"
                  ]
                },
                "resource": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![\\s\\S]*[\\\\\\x00-\\x1f\\x7f])(?![A-Za-z][A-Za-z0-9+.\\-]*:)(?!/)(?!(?:[\\s\\S]*/)?\\.\\.(?:/|$))(?!(?:\\.?/)*\\.?$)(?=[\\s\\S]*\\S)"
                }
              },
              "required": [
                "kind",
                "resource"
              ]
            }
          },
          "coverage": {
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "effects"
        ]
      }
    }
  },
  "required": [
    "unitsRequestVersion",
    "units"
  ]
}
