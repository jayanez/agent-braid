{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-braid.org/schemas/0.1.0-alpha/git-runtime-state.schema.json",
  "title": "Bounded local Git runtime state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gitRuntimeStateVersion": {
      "const": "0.1.0-alpha"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "phase": {
      "enum": [
        "initializing",
        "ready",
        "applying",
        "completed",
        "aborting",
        "aborted"
      ]
    },
    "nextIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    }
  },
  "required": [
    "gitRuntimeStateVersion",
    "manifestDigest",
    "phase",
    "nextIndex"
  ]
}
